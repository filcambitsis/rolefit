# SQLite in work/rolefit.db is the default. Override only for PostgreSQL:
# DATABASE_URL=postgresql+psycopg://rolefit:rolefit@localhost:5432/rolefit
APP_ENV=development
DEV_AUTH=true
CORS_ORIGINS=["http://localhost:3002","http://127.0.0.1:3002"]
SUPABASE_URL=
SUPABASE_AUDIENCE=authenticated
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_BUDGET_USD=5
LLM_INPUT_USD_PER_MILLION=5
LLM_OUTPUT_USD_PER_MILLION=20
